# systemd unit — SmartWeb on 192.168.2.93:8086
# Install:  sudo cp deploy/smartweb.service /etc/systemd/system/ && sudo systemctl daemon-reload
#           sudo systemctl enable --now smartweb
[Unit]
Description=SmartWeb (SmartBank web client)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/smartweb/web
Environment=HOST=0.0.0.0
Environment=PORT=8086
# SmartWeb API (api/): forward /api to it
# Environment=API_TARGET=http://127.0.0.1:8000
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=3
User=smartweb

[Install]
WantedBy=multi-user.target
