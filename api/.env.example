# Copy to api/.env and adjust. Environment variables override this file.

# Database aliases shown on the logon screen -> Oracle DSN (host:port/service or a TNS name)
SB_DATABASES={"PDBNBC": "192.168.2.10:1521/PDBNBC"}
SB_DEFAULT_DATABASE=PDBNBC

# Oracle 11g or older needs Oracle Instant Client ("thick" mode); 12.1+ works without it
#SB_ORACLE_CLIENT_LIB=/opt/oracle/instantclient_21_15

# Close a web session's Oracle connection after this many idle minutes
SB_SESSION_TIMEOUT=60
SB_MAX_ROWS=100000

# off | audit | enforce  (audit: unknown statements are logged to SB_AUDIT_FILE)
SB_ALLOWLIST=audit
#SB_AUDIT_FILE=/var/log/smartweb/unknown-sql.log

# Only needed when browsers call the API directly instead of through the web server's /api proxy
#SB_CORS_ORIGINS=http://192.168.2.93:8086

# Session NLS settings applied at logon, as the desktop clients had them (empty = Oracle default).
# Code that compares DATE columns with text (e.g. Vergi ödənişləri: sys_date between :begin_dat) needs a
# day-first format; Oracle accepts '/', '.' or '-' as separators with either value.
SB_NLS_DATE_FORMAT=DD.MM.YYYY
#SB_NLS_NUMERIC_CHARACTERS=.,
