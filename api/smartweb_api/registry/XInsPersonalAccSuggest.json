 "datasets": [
  {
   "name": "ODSPAccident",
   "source": "TPAccidentSuggest.ODSPAccident",
   "kind": "TOracleDataSet",
   "sql": "select pacc.rowid,pacc.* from ins_grouppersonalaccident pacc where pacc.id=:id",
   "variables": [
    {
     "name": "ID",
     "type": "float"
    }
   ],
   "unit": "UPAccidentSuggest"
  },
  {
   "name": "ODSPAccSuggest",
   "source": "TPAccidentSuggest.ODSPAccSuggest",
   "kind": "TOracleDataSet",
   "sql": "select  s.rowid,s.* from ins_pacc_suggestion s\nwhere paid = :paid",
   "variables": [
    {
     "name": "PAID",
     "type": "float"
    }
   ],
   "unit": "UPAccidentSuggest"
  },
  {
   "name": "ODSCondition",
   "source": "TPAccidentSuggest.ODSCondition",
   "kind": "TOracleDataSet",
   "sql": "select idr.rowid, idr.* from ins_dict_conditions idr",
   "variables": [],
   "unit": "UPAccidentSuggest"
  },
  {
   "name": "ODSContracts",
   "source": "TPAccidentSuggest.ODSContracts",
   "kind": "TOracleDataSet",
   "sql": "select ic.rowid, ic.* from ins_contracts ic\nwhere blank_id = :blankid\nand type_id = 3",
   "variables": [
    {
     "name": "BLANKID",
     "type": "float"
    }
   ],
   "unit": "UPAccidentSuggest"
  },
  {
   "name": "AValute",
   "source": "TPAccidentSuggest.AValute",
   "kind": "TOracleDataSet",
   "sql": "select valute, val_name, valu_name, valu_short from avalute",
   "variables": [],
   "unit": "UPAccidentSuggest"
  },
  {
   "name": "Customers",
   "source": "TPAccidentSuggest.Customers",
   "kind": "TOracleDataSet",
   "sql": "select c.rowid,c.id,c.name||' '||c.surname||' '||c.fathername as name,c.address,c.mobilephone,c.fax from ins_customers c",
   "variables": [],
   "unit": "UPAccidentSuggest"
  },
  {
   "name": "Risks",
   "source": "TPAccidentSuggest.Risks",
   "kind": "TOracleDataSet",
   "sql": "select idr.rowid, idr.* from ins_dict_risks idr",
   "variables": [],
   "unit": "UPAccidentSuggest"
  },
  {
   "name": "ODSBeneficiary",
   "source": "TPAccidentSuggest.ODSBeneficiary",
   "kind": "TOracleDataSet",
   "sql": "select ib.rowid,ib.* from ins_beneficiary ib",
   "variables": [],
   "unit": "UPAccidentSuggest"
  },
