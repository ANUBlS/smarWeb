   "sql": "SELECT im.ROWID, im.*,ic.*, ims.ID meds_id, imp.ID medp_id\n  FROM ins_medical im, ins_med_suggestion ims, ins_med_policy imp, ins_customers ic\n WHERE ic.ID = im.kli_id \n  AND im.ID = ims.med_id(+) \n  AND ims.ID = imp.meds_id(+) AND im.CLOSE_PREFIX=0\n\n",
