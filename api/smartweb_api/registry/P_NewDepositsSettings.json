   "source": "TNewDepositsFormAccName.Accounts",
   "kind": "TOracleDataSet",
   "sql": "select \n   id,\n   acc_no,\n   name,\n   val_acc,\n   Filial Filialid,\n   (select val_name from avalute where valute=val_acc)valname,\n   (select name from filial where id=filial)Filial\nfrom \n   account \nwhere \n   close_dat is null and (val_acc<=:val_acc)\n  and  \n   bal_cn1 in ( select accgroup from \n   dm_acc_zone_info where zoneid = (select zoneid from dm_acc_zones\n   where name = 'IncomeLossAccs'))   \n\n:psearch\norder by acc_no",
