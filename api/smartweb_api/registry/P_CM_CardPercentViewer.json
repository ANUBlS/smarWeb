  {
   "name": "Tranchrest",
   "source": "TDMCardPercent.Tranchrest",
   "kind": "TOracleDataSet",
   "sql": "\nSELECT hdate, tranchid, rest, intrest\n  FROM cm_cardtrchrests\n  where tranchid = :TrID\n  order by hdate",
   "variables": [
    {
     "name": "TRID",
     "type": "integer"
    }
   ],
   "unit": "DMCardPercentImpl"
  },
  {
   "name": "TranchcalcedPer",
   "source": "TDMCardPercent.TranchcalcedPer",
   "kind": "TOracleDataSet",
   "sql": "\nSELECT   hdate, tranchid, interest\n    FROM cm_cardtrchintrests\n   WHERE tranchid = :trid\nORDER BY hdate",
   "variables": [
    {
     "name": "TRID",
     "type": "integer"
    }
   ],
   "unit": "DMCardPercentImpl"
  },
  {
   "name": "Tranchpayments",
