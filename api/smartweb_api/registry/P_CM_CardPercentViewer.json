   "source": "TDMCardPercent.Tranches",
   "kind": "TOracleDataSet",
   "sql": "SELECT id, creditid, tranchedate, trancheamount\n  FROM cm_tranches\nwhere CreditID = :CrdID\norder by tranchedate",
