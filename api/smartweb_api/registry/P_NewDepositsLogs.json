   "source": "TNewDepositsFrmLogs.ResultControl",
   "kind": "TOracleDataSet",
   "sql": "SELECT \n   trunc(timestamp) timestamp, who, tname, \n  (select  desciption from dm_contracts_columname where name=trim(cname)) cname, old, new, rid,depid,\n  (select contractno from dm_contracts where id=depid) contractno, \n  (select name from filial where id in(select branchid from dm_contracts where id=depid)) filial\nFROM \n   dm_audit \n  WHERE\n     trunc(timestamp) between :bdat and :edat\n    \n     \n  order by trunc(timestamp)",
