   "source": "TDMWReport.ReplaceDataSet",
   "kind": "TOracleDataSet",
   "sql": "SELECT\n   B.TEMPLATEID , B.BOOKMARKNAME , A.FIELDNAME\nFROM\n   sbCM_WR_BOOKMARKS B\n , sbCM_WR_FIELDS A\nWHERE\n     (B.FIELDID = A.ID)\n   AND templateid = :tid\n   AND bookmarkname = :bname",
   "variables": [
