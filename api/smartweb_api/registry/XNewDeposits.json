   "variables": [],
   "unit": "NewDepositDataModule"
  },
  {
   "name": "users",
   "source": "TNewDepsitDataModule.users",
   "kind": "TOracleDataSet",
   "sql": "select id,name from user$\nwhere id in (select sid# from dm_contracts group by sid#)",
   "variables": [],
   "unit": "NewDepositDataModule"
  },
  {
   "name": "DmDataSet",
   "source": "TNewDepsitDataModule.DmDataSet",
   "kind": "TOracleDataSet",
   "sql": "select cont.rowid,\n       cont.id,\n       cont.contractno,\n       av.val_name,\n       dm_stored_programs.getcustomername(cont.customerid) as CustomerName,\n       cont.opendate,\n       cont.closedate,\n       cont.amount,\n       interest,      \n       (select sum(facticaldebt) from dm_history_currstate where id#=cont.id) as facticaldebt ,\n       (select sum(facticalinterestdebt) from dm_history_currstate where id#=cont.id) as facticalinterestdebt,\n       (select ostat from tenostat where acc_id=acc.clientaccid) as ostat,\n      (select type from dm_types where id=cont.contracttype)as contracttypename,\n       cont.currency,\n       cont.personaltype,\n       cont.clienttype,\n       cont.branchid,\n       cont.contracttype,\n       cont.customerid,\n       cont.prolongationdate,\n       cont.stopcalcdate,\n       cont.sid# as usid,\n       cont.agentid,\n       (select name from user$ where id=cont.sid#) username,\n       (select name from filial where id=cont.branchid) as filial\nfrom dm_active_contracts cont,\n     dm_contract_accounts acc,\n     avalute av\nwhere acc.id# = cont.id and\n      cont.currency = av.valute \norder by :OrderField     ",
   "variables": [
    {
     "name": "ORDERFIELD",
     "type": "string"
    }
   ],
   "unit": "NewDepositDataModule"
  },
  {
   "name": "dm_tranches",
   "source": "TNewDepsitDataModule.dm_tranches",
   "kind": "TOracleDataSet",
   "sql": "SELECT total,hdate\n  FROM dm_tranches\n  where id# = :ContractID\norder by hdate",
   "variables": [
    {
     "name": "CONTRACTID",
     "type": "integer"
    }
   ],
   "unit": "NewDepositDataModule"
  }
 ],
