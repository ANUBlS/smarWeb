 "datasets": [
  {
   "name": "ScheduleData",
   "source": "TScheduleDataModule.ScheduleData",
   "kind": "TOracleDataSet",
   "sql": "SELECT Z.RowID,Z.*\n  FROM CM_PAYMENT_SCHEDULE Z\nWHERE Z.CREDITID=:CREDITID\nORDER BY PAYMENTDATE",
   "variables": [
    {
     "name": "CREDITID",
     "type": "integer"
    }
   ],
   "unit": "ipScheduleDataModuleImpl"
  },
  {
   "name": "BoorowerInfo",
   "source": "TScheduleDataModule.BoorowerInfo",
   "kind": "TOracleDataSet",
   "sql": "SELECT\n   NAME\nFROM\n  CM_BOOROWERINFO\nWHERE CreditID=:CREDITID",
   "variables": [
    {
     "name": "CREDITID",
     "type": "integer"
    }
   ],
   "unit": "ipScheduleDataModuleImpl"
  },
  {
   "name": "CreditInfo",
   "source": "TScheduleDataModule.CreditInfo",
   "kind": "TOracleDataSet",
   "sql": "SELECT\n   A.ID , A.CURRENCY , A.CREDITLINEAMOUNT , A.ANNUALYINTERESTRATE,a.ANNUALBANKRATE , A.DATEOFCONCLUSION\n , A.DUEDATEFIRSTCONTRACT , A.CREDITTYPE,A.newfinanceamount,\n  c.rest\nFROM\n   CM_ACTIVE_CREDITS A,\n   cm_curr_state c\nWHERE ID=:ID\nand a.id =c.creditid",
   "variables": [
    {
     "name": "ID",
     "type": "integer"
    }
   ],
   "unit": "ipScheduleDataModuleImpl"
  },
  {
   "name": "Exportdata",
   "source": "TScheduleDataModule.Exportdata",
   "kind": "TOracleDataSet",
   "sql": "select paymentdate, principal, interest, ipinterest\n  FROM cm_payment_schedule\nwhere creditid=:crdid\norder by paymentdate",
   "variables": [
    {
     "name": "CRDID",
     "type": "integer"
    }
   ],
   "unit": "ipScheduleDataModuleImpl"
  },
  {
   "name": "IPInfo",
   "source": "TScheduleDataModule.IPInfo",
   "kind": "TOracleDataSet",
   "sql": "SELECT  bankopendate, bankclosedate\n  FROM cm_ip_info\nwhere creditid =:CrdID",
   "variables": [
    {
     "name": "CRDID",
     "type": "integer"
    }
   ],
   "unit": "ipScheduleDataModuleImpl"
  },
  {
   "name": "AboutContractDataSet",
   "source": "TTrancheSheduleDataMod.AboutContractDataSet",
   "kind": "TOracleDataSet",
   "sql": "SELECT V.VAL_NAME as CURRENCY\n     , C.NAME as CUSTNAME\n     , P.CREDITLINEAMOUNT as AMOUNT\n  FROM CM_ACTIVE_CREDITS P\n      ,CM_BOOROWERINFO C\n      ,SB_AVALUTE V\n WHERE P.ID = C.CREDITID\n   AND P.CURRENCY = V.VALUTE\n   AND ID = :ID",
   "variables": [
    {
     "name": "ID",
     "type": "integer"
    }
   ],
   "unit": "ipTrancheScheduleDataModuleImpl"
  },
  {
   "name": "TrancheScheduleDataSet",
   "source": "TTrancheSheduleDataMod.TrancheScheduleDataSet",
   "kind": "TOracleDataSet",
   "sql": "SELECT T.RowID, T.*\n  FROM CM_TRANCHE_SCHEDULE T\n WHERE T.CREDITID = :CREDITID",
   "variables": [
    {
     "name": "CREDITID",
     "type": "integer"
    }
   ],
   "unit": "ipTrancheScheduleDataModuleImpl"
  }
