   "sql": "Select \n    O.val_kod,\n    O.ostat,\n    O.dat,\n    A.val_name \nFrom \n   Operkurs O,\n   Avalute A\nWhere O.val_kod=A.valute and o.dat between :beg_dat and :end_dat\nOrder by :Title_Order",
