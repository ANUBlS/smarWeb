   "name": "ODS_SB_BUSINESS_PROC_TARIFS",
   "source": "TDMBusProcSet.ODS_SB_BUSINESS_PROC_TARIFS",
   "kind": "TOracleDataSet",
   "sql": "select t.rowid,a.name,t.* from SB_BUSINESS_PROC_TARIFS t,qrp_klie_viwe a\n\nwhere bpchildid = :bpchildid and t.groupid=a.id\n\n\n\n\norder by groupid,minamt",
