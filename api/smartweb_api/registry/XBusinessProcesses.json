   "name": "ODS_sb_business_proc_childs",
   "source": "TDMBusProcSet.ODS_sb_business_proc_childs",
   "kind": "TOracleDataSet",
   "sql": "select   c.rowid, c.* , ad.acc_no debtacc, ac.acc_no kredacc, r.name reportdesc, p.name country,ca.fullpath as kassa_z_name,t.name as vid_op_name,k.cntr_name as cntr_name \n --(select  from convert_assignments where shortname=) as kassa_z_name\n    from sb_business_proc_childs c,\n         sb_bproc_acc ad,\n         sb_bproc_acc ac,\n         provcountries p,\n         reportdescs r,\n         vid_op t,\n         countries k,\n         convert_assignments ca\n   where parentid = :parentid and c.debt = ad.id and kredit = ac.id(+) and \n   countrid = p.id(+) and reportid = r.id(+) and c.kassa_z = ca.shortname(+) and c.vid_op=t.id(+) and c.countrid=k.id(+)\norder by operid",
   "variables": [
    {
     "name": "PARENTID",
     "type": "integer"
    },
    {
     "name": "SORT",
     "type": "subst"
    }
   ],
   "unit": "DMBusProcSetimpl"
  },
