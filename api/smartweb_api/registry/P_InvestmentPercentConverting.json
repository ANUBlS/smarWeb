 "datasets": [
  {
   "name": "CalcedDeposits",
   "source": "TDMPercentConverting.CalcedDeposits",
   "kind": "TOracleDataSet",
   "sql": "select \n cont.id,\n cont.contractno,\n dm_stored_programs.GetContractAccountName(acc.contractaccid) as custname,\n cstate.facticaldebt,\n dm_stored_programs.GetClientFacticalDebt(acc.clientaccid) as facticalinterestdebt,\n cint.interest,\n cont.interest as percent,\n dm_stored_programs.CheckContractState(cont.ID) as  Status,\n av.val_name,\n cont.currency,\n cont.personaltype,\n cont.clienttype,\n cont.customerid,\n cont.branchid\nfrom dm_contracts cont,\n     dm_contract_accounts acc,\n     dm_history_currstate cstate,\n     dm_interest_currstate cint,\n     avalute av\nwhere cont.type# = 3\nand acc.id# = cont.id\nand cstate.id# = cont.id\nand cint.id# = cont.id \nand cont.currency=av.valute\n\norder by :OrderField",
   "variables": [
    {
     "name": "ORDERFIELD",
     "type": "subst"
    }
   ],
   "unit": "PercentConvertingImpl"
  },
  {
   "name": "Valutes",
   "source": "TDMPercentConverting.Valutes",
   "kind": "TOracleDataSet",
   "sql": "select valute,valu_name from avalute",
