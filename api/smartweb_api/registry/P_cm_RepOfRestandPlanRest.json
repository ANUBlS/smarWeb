   "sql": "select   \n     p.numberofcredit,\n     h.rest,\n     h.interestrest,\n     cm_utils.Get_creditPlanPrincipal(p.id,:dat)+\n     cm_utils.Get_creditPlaninterest(p.id,:dat) as annutyamt,\n     cm_utils.get_PlanRest(p.id,:dat) as planrest,cm_utils.get_lastPaymentDate(p.id) as lastdat,\n     cm_utils.get_PlanRest(p.id,:dat) - h.rest as difrest,\n\t ugr.description \nfrom cm_portfolio p,\n     cm_history h,\n     cm_usergroups ugr\nwhere\n    p.id = h.creditid and\n    h.hdate = :dat and\n    p.usrgroup = ugr.id\n    \n    ",
