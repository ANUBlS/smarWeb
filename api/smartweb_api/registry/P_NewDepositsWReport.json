   "source": "TNewDepositsDMWReport.ReplaceDataSet",
   "kind": "TOracleDataSet",
   "sql": "SELECT\n   B.TEMPLATEID , B.BOOKMARKNAME , A.FIELDNAME\nFROM\n   DM_WR_BOOKMARKS B\n , DM_WR_FIELDS A\nWHERE\n     (B.FIELDID = A.ID)\n   AND templateid = :tid\n   AND bookmarkname = :bname",
   "variables": [
    {
     "name": "TID",
     "type": "integer"
