   "name": "Capitals",
   "source": "TfrmCapitalize.Capitals",
   "kind": "TOracleDataSet",
   "sql": "\nSELECT ID,  hdate, total, trid\n  FROM sbcm_capitalization\n  where ID# = :ContractID",
   "variables": [
    {
     "name": "CONTRACTID",
     "type": "integer"
    }
   ],
   "unit": "frmCapitalizeImpl"
  },
  {
   "name": "DepositInfo",
   "source": "TfrmCapitalize.DepositInfo",
   "kind": "TOracleDataSet",
   "sql": "select cont.contractno,\n       cust.name,\n       cstate.facticaldebt,\n       cstate.facticalinterestdebt,\n       sbcm_stored_programs.Get_ContractAccount(acc.ContractAccID) as ContractAccNo,\n      sbcm_stored_programs.Get_ContractAccount(acc.InterestAccID) as InterestAccNo\nfrom sbcm_contracts cont,\n     customers cust,\n     sbcm_contract_accounts acc,\n     sbcm_contract_state cstate\nwhere\n    cont.id = :ContractID and\n    cust.id = cont.customerID and\n    acc.id# = :ContractID and\n    cstate.id# = :ContractID ",
   "variables": [
    {
     "name": "CONTRACTID",
     "type": "integer"
    }
   ],
   "unit": "frmCapitalizeImpl"
  }
 ],
