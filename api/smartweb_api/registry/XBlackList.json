   "sql": "select idcust, name ,lastname,convertpack.CONVERT_INT( name )e_name,convertpack.CONVERT_INT( lastname )e_lastname from custinfo   where  idcust in (select boorowerid from cm_active_credits)\nand idcust in(select id from customers where cust_type not in(0))\n--and idcust=319\n/*select*from (\n\nselect idcust, name ,lastname,convertpack.CONVERT_INT( name )e_name,convertpack.CONVERT_INT( lastname )e_lastname,\nconvertpack.CONVERT_INT( name )||convertpack.CONVERT_INT( lastname ) ch from custinfo   where  idcust in (select boorowerid from cm_active_credits)\n)\nwhere ch not in(select name||surname from sanctions_data_copy where trunc(created_at)='28-nov-2025')\n*/",
   "variables": [],
