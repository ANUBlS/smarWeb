   "name": "ods_hms",
   "source": "TBlackInst.ods_hms",
   "kind": "TOracleDataSet",
   "sql": "select b.*,\n  case\n      WHEN main_status LIKE 'Match%' THEN 'Match 80-100%'\n    WHEN main_status LIKE 'Close%' THEN 'Close 50-79%'\n    WHEN main_status LIKE 'No Match%' THEN 'No Match 0-49%'  \n  END AS end_status \n from (\nselect a.*,  CASE\n   \n    WHEN status LIKE 'Match%' THEN 'Match'\n    WHEN status LIKE 'No Match%' THEN 'No Match'\n    WHEN status LIKE 'Close%' THEN 'Close'  \n  END AS main_status \nfrom black_inspection a where chekdate between :dat1 and :dat2        \norder by chekdate, custid)b\n\n\n\n\n\n\n",
   "variables": [
    {
     "name": "DAT1",
     "type": "date"
    },
    {
     "name": "DAT2",
     "type": "date"
    }
   ],
   "unit": "BlackListImpl"
  },
