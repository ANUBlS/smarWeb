 "datasets": [
  {
   "name": "ScheduleData",
   "source": "TScheduleDataModule.ScheduleData",
   "kind": "TOracleDataSet",
   "sql": "SELECT Z.RowID,Z.*\n  FROM CM_PAYMENT_SCHEDULE Z\nWHERE Z.CREDITID=:CREDITID\nORDER BY PAYMENTDATE",
   "variables": [
    {
     "name": "CREDITID",
     "type": "integer"
    }
   ],
   "unit": "cuScheduleDataModuleImpl"
  },
  {
   "name": "BoorowerInfo",
   "source": "TScheduleDataModule.BoorowerInfo",
   "kind": "TOracleDataSet",
   "sql": "SELECT\n   bi.NAME,\n   cm_common.AccountNumber_Get(a.booroweraccid) as custaccno,\n   cm_common.AccountNumber_Get(a.Loanaccid) as loanaccno  \nFROM\n  CM_BOOROWERINFO bi, cm_accounts a\nWHERE bi.CreditID=:CREDITID\nand a.creditid = :CREDITID",
   "variables": [
    {
     "name": "CREDITID",
     "type": "integer"
    }
   ],
   "unit": "cuScheduleDataModuleImpl"
  },
  {
   "name": "CreditInfo",
   "source": "TScheduleDataModule.CreditInfo",
   "kind": "TOracleDataSet",
   "sql": "SELECT\n   A.ID , A.CURRENCY , A.CREDITLINEAMOUNT , A.ANNUALYINTERESTRATE , A.DATEOFCONCLUSION\n , A.DUEDATEFIRSTCONTRACT , \n   A.CREDITTYPE,a.branchid,\n   TRUNC (MONTHS_BETWEEN (A.DUEDATEFIRSTCONTRACT ,A.DATEOFCONCLUSION)) as period,v.val_name,\n   c.rest\nFROM\n   CM_ACTIVE_CREDITS A,avalute v,\n   cm_curr_state c\nWHERE a.ID=:ID\nand c.creditid = :ID\nand a.currency=v.valute\n",
   "variables": [
    {
     "name": "ID",
     "type": "integer"
    }
   ],
   "unit": "cuScheduleDataModuleImpl"
  },
  {
   "name": "ExportData",
   "source": "TScheduleDataModule.ExportData",
   "kind": "TOracleDataSet",
   "sql": "SELECT  paymentdate, principal, interest,rest\n  FROM cm_payment_schedule\nwhere Creditid=:CREDITID\nORDER BY PAYMENTDATE",
   "variables": [
    {
     "name": "CREDITID",
     "type": "integer"
    }
   ],
   "unit": "cuScheduleDataModuleImpl"
  },
  {
   "name": "BankInfo",
   "source": "TScheduleDataModule.BankInfo",
   "kind": "TOracleDataSet",
   "sql": "select BANK,logo,az_name from smart.bankinfo",
   "variables": [],
   "unit": "cuScheduleDataModuleImpl"
  },
  {
   "name": "FilialInfo",
   "source": "TScheduleDataModule.FilialInfo",
   "kind": "TOracleDataSet",
   "sql": "select id,name from filial\nwhere id = :brid \n--smart.sb_aca.getuserfilialid(user)",
   "variables": [
    {
     "name": "BRID",
     "type": "integer"
    }
   ],
   "unit": "cuScheduleDataModuleImpl"
  },
  {
   "name": "HeadOfficeID",
   "source": "TScheduleDataModule.HeadOfficeID",
   "kind": "TOracleDataSet",
   "sql": "select min(id) as minid from smart.filial_t",
   "variables": [],
   "unit": "cuScheduleDataModuleImpl"
  }
 ],
