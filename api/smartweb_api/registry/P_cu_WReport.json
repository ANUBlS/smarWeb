   "unit": "CUAgreeDataModImplUnit"
  },
  {
   "name": "ReplaceDataSet",
   "source": "TAgreeDataModule.ReplaceDataSet",
   "kind": "TOracleDataSet",
   "sql": "SELECT\n   B.TEMPLATEID , B.BOOKMARKNAME , A.FIELDNAME\nFROM\n   CM_WR_BOOKMARKS B\n , CM_WR_FIELDS A\nWHERE\n     (B.FIELDID = A.ID)\n   AND templateid = :tid\n   AND bookmarkname = :bname",
   "variables": [
    {
     "name": "TID",
     "type": "integer"
    },
    {
     "name": "BNAME",
     "type": "string"
    }
   ],
   "unit": "CUAgreeDataModImplUnit"
  },
  {
   "name": "yazi",
   "source": "TAgreeDataModule.yazi",
   "kind": "TOracleDataSet",
   "sql": "select p.CREDITLINEAMOUNT,v.VALU_NAME ,round(months_between(p.duedatefirstcontract, p.dateofconclusion)) per, h.pledgeprice\nfrom cm_active_credits p,avalute v,cm_curr_state h\nwhere p.id=:id \nand p.currency=v.VALUTE and p.id=h.creditid\n",
   "variables": [
    {
     "name": "ID",
     "type": "integer"
    }
   ],
