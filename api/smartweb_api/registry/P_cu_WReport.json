   "source": "TAgreeDataModule.CreditInfoDataSet",
   "kind": "TOracleDataSet",
   "sql": "SELECT a.* ,:man as manat ,:dat as data,:gir as GIROW\n  FROM cm_wr_creditinfo a\n where a.creditid = :crid",
