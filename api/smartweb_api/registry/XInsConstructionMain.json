  },
  {
   "name": "ODSContracts",
   "source": "TConstructionMain.ODSContracts",
   "kind": "TOracleDataSet",
   "sql": "select ic.rowid, ic.* from ins_contracts ic\nwhere blank_id = :blankid\nand type_id = 10",
   "variables": [
    {
     "name": "BLANKID",
     "type": "float"
    }
   ],
   "unit": "UConstructionMain"
  },
  {
   "name": "Customers",
