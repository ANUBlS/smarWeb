 "datasets": [
  {
   "name": "ODSPayments",
   "source": "TPayDataMod.ODSPayments",
   "kind": "TOracleDataSet",
   "sql": "select ip.*,  ii.name \n  from ins_payments ip, ins_contracts ic, INS_INSURANCES ii\nwhere \n  ic.id = ip.ins_id\nand\n  ii.id = ic.type_id \n\nand ip.ins_id = :insid",
   "variables": [
    {
     "name": "INSID",
     "type": "float"
    }
   ],
   "unit": "InsDataMod"
  },
  {
   "name": "ODSPlan",
   "source": "TPayDataMod.ODSPlan",
   "kind": "TOracleDataSet",
   "sql": "SELECT -1 as ID, 'Plandan kənar' as paydate, 0 as ammount, 0 as status\n  FROM DUAL\nUNION ALL\nSELECT a.ID, TO_CHAR (a.pay_date) as paydate, a.ammount, a.status\n  FROM ins_payment_plan a\nwhere a.ins_id = :insid",
   "variables": [
    {
     "name": "INSID",
     "type": "float"
    }
   ],
   "unit": "InsDataMod"
  }
 ],
