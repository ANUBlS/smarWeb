 "datasets": [
  {
   "name": "ODSContracts",
   "source": "TfrmMainCProperty.ODSContracts",
   "kind": "TOracleDataSet",
   "sql": "select ic.rowid, ic.* from ins_contracts ic\nwhere id = :cid\nand type_id = 5",
   "variables": [
    {
     "name": "CID",
     "type": "float"
    }
   ],
   "unit": "UMainCProperty"
  },
  {
   "name": "ODSCProperty",
   "source": "TfrmMainCProperty.ODSCProperty",
   "kind": "TOracleDataSet",
   "sql": "select icu.name||' '||icu.surname||' '||icu.fathername as name,cp.rowid,cp.*,ic.begin_date,ic.end_date from ins_commercialproperty cp,ins_contracts ic,ins_customers icu where icu.id=ic.kli_id and ic.id=cp.cid and cp.close_prefix=0 and ic.type_id=5 order by cp.:title",
   "variables": [
    {
     "name": "TITLE",
     "type": "string"
    }
   ],
   "unit": "UMainCProperty"
  },
  {
   "name": "ODSCustomers",
   "source": "TfrmMainCProperty.ODSCustomers",
   "kind": "TOracleDataSet",
   "sql": "select c.rowid,c.id,c.name||' '||c.surname||' '||c.fathername as name,c.address,c.mobilephone,c.fax,c.contactperson,c.contactpersonphone from ins_customers c",
   "variables": [],
   "unit": "UMainCProperty"
  },
  {
   "name": "ODSBeneficiary",
