     "type": "float"
    }
   ],
   "unit": "UPAccidentBlank"
  },
  {
   "name": "ODSCustomers",
   "source": "TPAccidentBlank.ODSCustomers",
   "kind": "TOracleDataSet",
   "sql": "select c.rowid,c.id,c.name||' '||c.surname||' '||c.fathername as name,c.address,c.mobilephone,c.fax from ins_customers c",
   "variables": [],
   "unit": "UPAccidentBlank"
  },
  {
   "name": "Risks",
