   "variables": [],
   "unit": "UPAccidentBlank"
  },
  {
   "name": "ODSContracts",
   "source": "TPAccidentBlank.ODSContracts",
   "kind": "TOracleDataSet",
   "sql": "select ic.rowid, ic.* from ins_contracts ic\nwhere blank_id = :blankid\nand type_id = 3",
   "variables": [
    {
     "name": "BLANKID",
     "type": "float"
    }
   ],
   "unit": "UPAccidentBlank"
  },
  {
   "name": "ODSPAccSuggest",
   "source": "TPAccidentBlank.ODSPAccSuggest",
   "kind": "TOracleDataSet",
   "sql": "select s.rowid,s.* from ins_pacc_suggestion s\nwhere paid = :paid",
   "variables": [
    {
     "name": "PAID",
     "type": "float"
    }
   ],
   "unit": "UPAccidentBlank"
  },
  {
