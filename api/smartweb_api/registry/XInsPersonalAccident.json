   "variables": [],
   "unit": "UPAccidentBlank"
  },
  {
   "name": "ODSPAccidentR",
   "source": "TPAccidentBlank.ODSPAccidentR",
   "kind": "TOracleDataSet",
   "sql": "select  PINS_FullMotor.returnName(kli_id) as name,Pins_FullMotor.returnAddress(kli_id) as Address,Pins_FullMotor.returnPhone(kli_id) as phone,pins_fullmotor.returnFax(kli_id) as fax,c.*from ins_grouppersonalaccident c  where c.id=:id",
   "variables": [
    {
     "name": "ID",
     "type": "float"
    }
   ],
   "unit": "UPAccidentBlank"
  },
  {
