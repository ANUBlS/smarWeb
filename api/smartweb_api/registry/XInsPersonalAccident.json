   "name": "ODSPAccident",
   "source": "TPAccidentBlank.ODSPAccident",
   "kind": "TOracleDataSet",
   "sql": "select pacc.rowid,pacc.* from ins_grouppersonalaccident pacc where pacc.id=:id",
   "variables": [
    {
