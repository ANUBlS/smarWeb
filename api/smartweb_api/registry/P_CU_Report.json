   "name": "CreditsDS",
   "source": "TPeriodReportForm.CreditsDS",
   "kind": "TOracleDataSet",
   "sql": "select b.ID   from CM_PORTFOLIO b where  ((B.CLOSEDATE IS NULL) or (B.CLOSEDATE between :HDATE and :EDATE) /*(B.CLOSEDATE >=:HDATE)*/)\n\n\n ",
