  {
   "name": "ResultDS",
   "source": "TPeriodReportForm.ResultDS",
   "kind": "TOracleDataSet",
   "sql": "SELECT p.numberofcredit, \n      r.*, \n      CM_AK_REPORTS.get_balcn(r.contractno) as balcn,\n       b.name,\n       h.descripion person,\n       g.description project,p.ANNUALYINTERESTRATE,\n       --f.name filial ,\n       get_filialname(p.branchid) filial,\n       V.Val_name,\n       p.DATEOFCONCLUSION,\n       p.DUEDATEFIRSTCONTRACT\n FROM CM_REPORT_SD1 r,\n      cm_boorowerinfo b,\n      cm_portfolio p,\n      cm_persons h,\n      cm_usergroups g,\n  --    sb_filial f,\n      AVALUTE V\n where \n      r.creditid = b.creditid\n   and r.creditid = p.id\n   and  v.Valute = p.Currency\n   and h.id = p.personaltype\n   and g.id = p.usrgroup\n --  and f.id = p.branchid  \n",
   "variables": [],
   "unit": "PeriodReport"
  }
