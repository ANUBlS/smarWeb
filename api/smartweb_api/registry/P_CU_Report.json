     "name": "HDATE",
     "type": "date"
    }
   ],
   "unit": "PeriodReport"
  },
  {
   "name": "Currencys",
   "source": "TPeriodReportForm.Currencys",
   "kind": "TOracleDataSet",
   "sql": "SELECT valute,  valu_name\n  FROM AVALUTE\nORDER BY VALUTE",
   "variables": [],
